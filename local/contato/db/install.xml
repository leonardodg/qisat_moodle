<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/contato/db" VERSION="20150730" COMMENT="XMLDB para o Moodle local/contato"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="estado" COMMENT="Tabela de estados brasileiros">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="6" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="nome" TYPE="text" LENGTH="50" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="uf" TYPE="text" LENGTH="2" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="cidade" COMMENT="Tabela de cidades brasileiras">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="uf" TYPE="int" LENGTH="6" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="nome" TYPE="text" LENGTH="50" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>