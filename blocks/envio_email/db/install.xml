<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="blocks/envio_email/db" VERSION="2015112600" COMMENT="XMLDB file for Moodle blocks/envio_email"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="envio_email" COMMENT="Defines envio_email" NEXT="envio_email_assign">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="20" NOTNULL="true" UNSIGNED="true" SEQUENCE="true" ENUM="false" NEXT="emailsubject"/>
		    <FIELD NAME="emailsubject" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" ENUM="false" PREVIOUS="id" NEXT="emailbody"/>
        <FIELD NAME="emailbody" TYPE="text" LENGTH="big" NOTNULL="true" SEQUENCE="false" PREVIOUS="emailsubject" NEXT="usermodified"/>
		    <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" DEFAULT="0" SEQUENCE="false" ENUM="false" PREVIOUS="emailbody" NEXT="timemodified"/>
		    <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" DEFAULT="0" SEQUENCE="false" ENUM="false" PREVIOUS="usermodified"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" COMMENT="Primary key for envio_email"/>
      </KEYS>
    </TABLE>
	  <TABLE NAME="envio_email_assign" COMMENT="Defines envio_email_assign" PREVIOUS="envio_email" NEXT="envio_email_sent">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" SEQUENCE="true" ENUM="false" NEXT="courseid"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0" SEQUENCE="false" ENUM="false" PREVIOUS="id" NEXT="emailid"/>
        <FIELD NAME="emailid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="false" DEFAULT="0" SEQUENCE="false" ENUM="false" PREVIOUS="courseid" NEXT="receiver"/>
		    <FIELD NAME="receiver" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false" ENUM="false" PREVIOUS="emailid" NEXT="groupid"/>
		    <FIELD NAME="groupid" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" DEFAULT="0" SEQUENCE="false" ENUM="false" PREVIOUS="receiver" NEXT="date"/>
		    <FIELD NAME="date" TYPE="int" LENGTH="10" NOTNULL="false" UNSIGNED="true" DEFAULT="0" SEQUENCE="false" ENUM="false" PREVIOUS="groupid" NEXT="pastdays"/>
		    <FIELD NAME="pastdays" TYPE="int" LENGTH="10" NOTNULL="false" UNSIGNED="true" DEFAULT="0" SEQUENCE="false" ENUM="false" PREVIOUS="date" NEXT="remainingdays"/>
            <FIELD NAME="remainingdays" TYPE="int" LENGTH="10" NOTNULL="false" UNSIGNED="true" DEFAULT="0" SEQUENCE="false" ENUM="false" PREVIOUS="pastdays" NEXT="usermodified"/>
            <FIELD NAME="coursecompletiondays" TYPE="int" LENGTH="10" NOTNULL="false" UNSIGNED="true" DEFAULT="0" SEQUENCE="false" ENUM="false" PREVIOUS="pastdays" NEXT="usermodified"/>
		    <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" DEFAULT="0" SEQUENCE="false" ENUM="false" PREVIOUS="remainingdays" NEXT="timemodified"/>
		    <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" DEFAULT="0" SEQUENCE="false" ENUM="false" PREVIOUS="usermodified"/>		
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>        
      </KEYS>
    </TABLE>
    <TABLE NAME="envio_email_sent" COMMENT="Defines envio_email_sent" PREVIOUS="envio_email_assign" NEXT="envio_email_sent_bkp">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="20" NOTNULL="true" UNSIGNED="true" SEQUENCE="true" ENUM="false" NEXT="emailassignid"/>
        <FIELD NAME="emailassignid" TYPE="int" LENGTH="20" NOTNULL="true" UNSIGNED="true" DEFAULT="0" SEQUENCE="false" ENUM="false" PREVIOUS="id" NEXT="userid"/>
		    <FIELD NAME="userid" TYPE="int" LENGTH="20" NOTNULL="true" UNSIGNED="true" DEFAULT="0" SEQUENCE="false" ENUM="false" PREVIOUS="emailassignid" NEXT="timesent"/>
		    <FIELD NAME="timesent" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" DEFAULT="0" SEQUENCE="false" ENUM="false" PREVIOUS="userid" NEXT="status"/>
        <FIELD NAME="status" TYPE="char" LENGTH="150" NOTNULL="true" DEFAULT="OK" SEQUENCE="false" ENUM="false" PREVIOUS="timesent"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>        
	    </KEYS>
    </TABLE>
    <TABLE NAME="envio_email_sent_bkp" COMMENT="Defines envio_email_sent_bkp" PREVIOUS="envio_email_sent">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="20" NOTNULL="true" UNSIGNED="true" SEQUENCE="true" ENUM="false" NEXT="emailassignid"/>
        <FIELD NAME="emailassignid" TYPE="int" LENGTH="20" NOTNULL="true" UNSIGNED="true" DEFAULT="0" SEQUENCE="false" ENUM="false" PREVIOUS="id" NEXT="userid"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="20" NOTNULL="true" UNSIGNED="true" DEFAULT="0" SEQUENCE="false" ENUM="false" PREVIOUS="emailassignid" NEXT="timesent"/>
        <FIELD NAME="timesent" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" DEFAULT="0" SEQUENCE="false" ENUM="false" PREVIOUS="userid" NEXT="status"/>
        <FIELD NAME="status" TYPE="char" LENGTH="150" NOTNULL="true" DEFAULT="OK" SEQUENCE="false" ENUM="false" PREVIOUS="timesent" NEXT="idreference"/>
        <FIELD NAME="idreference" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" DEFAULT="0" SEQUENCE="false" ENUM="false" PREVIOUS="timesent"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>        
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>