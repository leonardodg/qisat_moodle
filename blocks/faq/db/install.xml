<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="blocks/faq/db" VERSION="2015092400" COMMENT="XMLDB file for Moodle blocks/faq"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="faq_artigo" COMMENT="Define os artigos da faq" NEXT="faq_autor">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" SEQUENCE="true" ENUM="false" NEXT="idcategoria"/>
		    <FIELD NAME="idcategoria" TYPE="int" LENGTH="10" NOTNULL="false" UNSIGNED="true" SEQUENCE="false" ENUM="false" PREVIOUS="id" NEXT="titulo"/>
        <FIELD NAME="titulo" TYPE="text" NOTNULL="false" SEQUENCE="false" PREVIOUS="idcategoria" NEXT="datacriacao"/>
		    <FIELD NAME="datacriacao" TYPE="int" LENGTH="10" NOTNULL="false" UNSIGNED="true" SEQUENCE="false" ENUM="false" PREVIOUS="titulo" NEXT="visualizacoes"/>
		    <FIELD NAME="visualizacoes" TYPE="int" LENGTH="10" NOTNULL="false" UNSIGNED="true" DEFAULT="0" SEQUENCE="false" ENUM="false" PREVIOUS="datacriacao" NEXT="assunto"/>
        <FIELD NAME="assunto" TYPE="text" NOTNULL="false" SEQUENCE="false" ENUM="false" PREVIOUS="visualizacoes" NEXT="artigo"/>
        <FIELD NAME="artigo" TYPE="text" NOTNULL="false" SEQUENCE="false" ENUM="false" PREVIOUS="assunto" NEXT="idautor"/>
        <FIELD NAME="idautor" TYPE="int" LENGTH="10" NOTNULL="false" UNSIGNED="true" SEQUENCE="false" ENUM="false" PREVIOUS="artigo" NEXT="ordem"/>
        <FIELD NAME="ordem" TYPE="int" LENGTH="10" NOTNULL="false" UNSIGNED="true" SEQUENCE="false" ENUM="false" PREVIOUS="idautor" NEXT="visivel"/>
        <FIELD NAME="visivel" TYPE="int" LENGTH="10" NOTNULL="false" UNSIGNED="true" DEFAULT="1" SEQUENCE="false" ENUM="false" PREVIOUS="ordem"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>
	  <TABLE NAME="faq_autor" COMMENT="Define os autores da faq" PREVIOUS="faq_artigo" NEXT="faq_avaliacao">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" SEQUENCE="true" ENUM="false" NEXT="autor"/>
        <FIELD NAME="autor" TYPE="char" LENGTH="50" NOTNULL="false" SEQUENCE="false" ENUM="false" PREVIOUS="id" NEXT="descricao"/>
        <FIELD NAME="descricao" TYPE="text" NOTNULL="false" SEQUENCE="false" ENUM="false" PREVIOUS="autor" NEXT="visivel"/>
		    <FIELD NAME="visivel" TYPE="int" LENGTH="10" NOTNULL="false" UNSIGNED="false" DEFAULT="1" SEQUENCE="false" ENUM="false" PREVIOUS="descricao"/>
		  </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>        
      </KEYS>
    </TABLE>
    <TABLE NAME="faq_avaliacao" COMMENT="Define as avaliacoes da faq" PREVIOUS="faq_autor" NEXT="faq_categoria">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" SEQUENCE="true" ENUM="false" NEXT="descricao"/>
        <FIELD NAME="descricao" TYPE="int" LENGTH="10" NOTNULL="false" UNSIGNED="true" SEQUENCE="false" ENUM="false" PREVIOUS="id" NEXT="idartigo"/>
		    <FIELD NAME="idartigo" TYPE="int" LENGTH="10" NOTNULL="false" UNSIGNED="true" SEQUENCE="false" ENUM="false" PREVIOUS="descricao" NEXT="idaluno"/>
		    <FIELD NAME="idaluno" TYPE="int" LENGTH="10" NOTNULL="false" UNSIGNED="true" SEQUENCE="false" ENUM="false" PREVIOUS="idartigo"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>        
	    </KEYS>
    </TABLE>
    <TABLE NAME="faq_categoria" COMMENT="Define as categorias da faq" PREVIOUS="faq_avaliacao" NEXT="faq_tags">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" SEQUENCE="true" ENUM="false" NEXT="categoria"/>
        <FIELD NAME="categoria" TYPE="char" LENGTH="50" NOTNULL="false" SEQUENCE="false" ENUM="false" PREVIOUS="id" NEXT="idcurso"/>
        <FIELD NAME="idcurso" TYPE="int" LENGTH="10" NOTNULL="false" UNSIGNED="true" SEQUENCE="false" ENUM="false" PREVIOUS="categoria" NEXT="idparent"/>
        <FIELD NAME="idparent" TYPE="int" LENGTH="10" NOTNULL="false" UNSIGNED="true" SEQUENCE="false" ENUM="false" PREVIOUS="idcurso" NEXT="ordem"/>
        <FIELD NAME="ordem" TYPE="int" LENGTH="10" NOTNULL="false" UNSIGNED="true" SEQUENCE="false" ENUM="false" PREVIOUS="idparent" NEXT="visivel"/>
        <FIELD NAME="visivel" TYPE="int" LENGTH="10" NOTNULL="false" UNSIGNED="true" DEFAULT="1" SEQUENCE="false" ENUM="false" PREVIOUS="ordem"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>        
      </KEYS>
    </TABLE>
    <TABLE NAME="faq_tags" COMMENT="Define as tags da faq" PREVIOUS="faq_categoria">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" UNSIGNED="true" SEQUENCE="true" ENUM="false" NEXT="descricao"/>
        <FIELD NAME="descricao" TYPE="text" NOTNULL="false" SEQUENCE="false" ENUM="false" PREVIOUS="id" NEXT="idartigo"/>
        <FIELD NAME="idartigo" TYPE="int" LENGTH="10" NOTNULL="false" UNSIGNED="true" SEQUENCE="false" ENUM="false" PREVIOUS="descricao"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>        
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>